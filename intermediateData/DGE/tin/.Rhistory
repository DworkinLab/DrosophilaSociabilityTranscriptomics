setwd("/Users/arteen/Desktop/tmp/SocRNA/tin/tin")
files <- list.files(pattern = ".txt")
tin_sum <- lapply(files, function(i){
x = read.table(i, header = TRUE )
x$file = i
x
})
tin_sum = do.call("rbind.data.frame", tin_sum)
lane <- rep(NA, times = nrow(tin_sum))
for (i in 1:length(tin_sum$file)){
file.name = tin_sum$file[i]
lane[i] <- substring(file.name,19,19)
}
tin_sum$lane <- lane
hist(tin_sum$TIN.median., main="Median TIN values")
#Samples that had low median TIN
low <- subset(tin_sum,tin_sum$TIN.median. <60)
low
tin_sum
colnames(tin_sum)[1] <- "File"
tin_sum
View(tin_sum)
tin_sum <- tin_sum[,-5]
write.csv(tin_sum, "TIN_values.csv", quote = F, row.names = F)
